
export default {
  async fetch(request, env) {
    const cors = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
      "Content-Type": "application/json"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: cors });
    }

    if (request.method !== "POST") {
      return Response.json(
        { error: "Tumia POST kuwasiliana na Kilimo AI." },
        { status: 405, headers: cors }
      );
    }

    if (!env.GEMINI_API_KEY) {
      return Response.json(
        { error: "Gemini API key haijawekwa kwenye Cloudflare Secrets." },
        { status: 500, headers: cors }
      );
    }

    try {
      const body = await request.json();
      const question = String(body.question || "").trim();

      if (!question || question.length > 5000) {
        return Response.json(
          { error: "Andika swali lisilozidi herufi 5000." },
          { status: 400, headers: cors }
        );
      }

      const systemPrompt = `
Wewe ni KILIMO AI, mtaalamu msaidizi wa kilimo na ufugaji.

Majukumu yako:
1. Jibu kwa Kiswahili rahisi na kinachoeleweka.
2. Saidia wakulima na wafugaji wa Tanzania na Afrika.
3. Toa elimu kuhusu mahindi, mpunga, maharage, mboga,
   matunda na mazao mengine.
4. Saidia kuhusu kuku, ng'ombe, mbuzi, kondoo na nguruwe.
5. Eleza dalili za magonjwa, kinga na hatua za kuchukua.
6. Toa ushauri wa lishe, mbolea, umwagiliaji na masoko.
7. Uliza maswali ya ziada pale taarifa hazijatosha.
8. Usibuni bei, dawa, dozi au taarifa za kitaalamu.
9. Kwa magonjwa makubwa, elekeza mtumiaji kwa afisa
   ugani au daktari wa mifugo.
10. Panga majibu kwa vichwa na hatua zinazofuatana.

Jibu kwa usahihi, kwa heshima na kwa lugha rahisi.
`;

      const response = await fetch(
        "https://generativelanguage.googleapis.com/v1beta/interactions",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "x-goog-api-key": env.GEMINI_API_KEY,
            "Api-Revision": "2026-05-20"
          },
          body: JSON.stringify({
            model: "gemini-3.8-flash",
            input: question,
            system_instruction: systemPrompt
          })
        }
      );

      const result = await response.json();

      if (!response.ok) {
        return Response.json(
          { error: result.error?.message || "Gemini haikupokea ombi." },
          { status: 502, headers: cors }
        );
      }

      const answer = (result.steps || [])
        .filter(step => step.type === "model_output")
        .flatMap(step => step.content || [])
        .filter(part => part.type === "text")
        .map(part => part.text)
        .join("\n");

      if (!answer) {
        return Response.json(
          { error: "AI haijarudisha jibu. Jaribu tena." },
          { status: 502, headers: cors }
        );
      }

      return Response.json(
        { answer },
        { headers: cors }
      );

    } catch (error) {
      return Response.json(
        { error: "Hitilafu ya mfumo: " + error.message },
        { status: 500, headers: cors }
      );
    }
  }
};
